{
    "compilerOptions": {
      "target": "ES6",
      "module": "CommonJS",
      "lib": ["ES6", "DOM"],
      "strict": true,
      "esModuleInterop": true,
      "skipLibCheck": true,
      "outDir": "dist",
      "resolveJsonModule": true
    },
    "include": [
      "src/**/*.ts", 
      "pages/**/*.ts"
    ],
    "exclude": ["node_modules"]
  }
  